/// Cross-layer end-to-end selective-disclosure test.
///
/// This proof is the REAL slim sumcheck proof produced by the Rust
/// `clis/nova` prover for the composite Predicate step circuit
/// (`circom/Predicate/predicate_nova.circom`, depth 2), folded for N=1 and
/// compressed with the sumcheck backend. It is embedded here byte-for-byte so
/// that the Aiken gate validates the exact output of the prover toolchain.
///
/// The gate policy binds:
///   x[0] = issuer_pk_u, x[1] = issuer_pk_v, x[2] = current_year,
///   x[3] = country_root, x[4] = eligible (= 1).
///
/// Success proves the full pipeline: witness generation -> IVC fold -> slim
/// compression (clis/nova) -> on-chain Fiat-Shamir sumcheck + predicate check
/// (aiken/nova).
use nova/verifier.{verify_predicate_gate}
use nova/types.{CircuitParams, FinalInstance, PredicatePolicy, SlimProof}

/// Real circuit parameters of the depth-2 Predicate step circuit.
const expected_params = CircuitParams {
  n_wires: 10463,
  n_constraints: 10461,
  n_pub_out: 5,
  n_pub_in: 5,
}

/// Real policy: issuer public key (u,v), current year and country root used
/// to generate the proof.
const expected_policy = PredicatePolicy {
  issuer_pk_u: 8624976883358443217689591740025020453161646046357019163238469549099359937631,
  issuer_pk_v: 34281186074026239166420402151535040043368197729731220730774434008950987285361,
  current_year: 2026,
  country_root: 16218807974226780999455818520759585013751930075124224204562176671238406323855,
}

