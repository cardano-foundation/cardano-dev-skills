/// Sparse Merkle tree over PoseidonBLS12_381, mirroring the Python simulator
/// (`aiken/f5/pool/pool.py` and `circom/PoseidonMerkle/helpers_py/poseidon_merkle.py`).
///
/// The tree is insert-only. An insertion carries the full Merkle *path*
/// (siblings from the leaf up) and is *path-verified* on-chain: the path must
/// recompute `old_root` from an empty leaf at the insertion index, otherwise
/// the insertion is rejected. This is what forces the on-chain cost of a root
/// transition to grow with the tree depth (see the pool-contract README).

use f5/poseidon

/// Value of an empty leaf position.
const empty_leaf = 0

/// Per-level subtree defaults for a tree of the given `depth`, ordered
/// top-down: `defaults[0]` is the root of the empty tree (used as the genesis
/// pool root), `defaults[depth]` is the empty-leaf value (`0`).
///
/// ```aiken
/// defaults(2) == [ poseidon(default, default), poseidon(0, 0), 0 ]
/// ```
pub fn defaults(depth: Int) -> List<Int> {
  // Build bottom-up: start from the empty leaf and hash up `depth` levels.
  do_defaults(depth, 0, [0])
}

fn do_defaults(depth: Int, level: Int, acc: List<Int>) -> List<Int> {
  if level >= depth {
    acc
  } else {
    when acc is {
      [top, .._rest] -> do_defaults(depth, level + 1, [poseidon.hash(top, top), ..acc])
      [] -> acc
    }
  }
}

/// The root of the empty tree at `depth` — the pool's genesis root.
pub fn default_root(depth: Int) -> Int {
  when defaults(depth) is {
    [root, ..] -> root
    [] -> 0
  }
}

/// Leaf-up sibling directions for inserting at `index` in a `depth` tree:
/// `dirs[k]` is `0` when the node on the path at level *k* (counting from the
/// leaves) is the left child, `1` when it is the right child.
pub fn path_dirs(index: Int, depth: Int) -> List<Int> {
  if depth <= 0 {
    []
  } else {
    [index % 2, ..path_dirs(index / 2, depth - 1)]
  }
}

/// Reconstruct a root from `leaf` (leaf-up) with `siblings` and `dirs` in
/// lockstep. Returns a bogus root (`0`) if the lists have mismatched length.
pub fn reconstruct(leaf: Int, siblings: List<Int>, dirs: List<Int>) -> Int {
  when (siblings, dirs) is {
    ([], []) -> leaf
    ([sib, ..rest_sib], [dir, ..rest_dir]) ->
      reconstruct(nest(leaf, sib, dir), rest_sib, rest_dir)
    _ -> 0
  }
}

fn nest(node: Int, sibling: Int, dir: Int) -> Int {
  if dir == 0 {
    poseidon.hash(node, sibling)
  } else {
    poseidon.hash(sibling, node)
  }
}

/// `True` iff `root` is the root obtained by placing `leaf` at `index` in the
/// current tree (i.e. the `siblings` path is a *valid* path for `root`).
pub fn valid_placement(root: Int, index: Int, depth: Int, leaf: Int, siblings: List<Int>) -> Bool {
  reconstruct(leaf, siblings, path_dirs(index, depth)) == root
}

/// Path-verified insertion of `leaf` at `index`.
///
/// The path must be valid for the current tree with an *empty* position at
/// `index` (`reconstruct(0, path, dirs) == old_root`); only then is the new
/// root (with `leaf` in place) returned. `None` on a bad path.
pub fn insert(old_root: Int, index: Int, depth: Int, leaf: Int, siblings: List<Int>) -> Option<Int> {
  if valid_placement(old_root, index, depth, empty_leaf, siblings) {
    Some(reconstruct(leaf, siblings, path_dirs(index, depth)))
  } else {
    None
  }
}

// ---------------------------------------------------------------------------
// Tests — goldens generated by the Python simulator
// ---------------------------------------------------------------------------

/// poseidon(0, 0) — the depth-1 default (also a sibling in depth-2 tests).
test t_default_h1() {
  poseidon.hash(0, 0) ==
    39704413365395714732902920194612999065094381874203236779011164022408220537174
}

/// depth-2 defaults, top-down: [h2, h1, 0].
test t_defaults_depth2() {
  let h1 = poseidon.hash(0, 0)
  let h2 = poseidon.hash(h1, h1)
  defaults(2) == [h2, h1, 0]
}

/// Root of the empty depth-2 tree (golden) — `defaults(2)` head.
test t_default_root_depth2() {
  default_root(2) == 21166726007557165859108861978192436261247706897160813168115151462471933547702
}

/// `path_dirs` for a few insertion indices at depth 2 and 4.
test t_path_dirs() {
  (path_dirs(0, 2) == [0, 0]) && (path_dirs(1, 2) == [1, 0])
    && (path_dirs(2, 2) == [0, 1]) && (path_dirs(3, 2) == [1, 1])
    && (path_dirs(4, 3) == [0, 0, 1]) && (path_dirs(5, 3) == [1, 0, 1])
}

/// `reconstruct` is the identity for a single node (no siblings).
test t_reconstruct_leaf_only() {
  reconstruct(42, [], []) == 42
}

/// Golden path verification (`depth = 2`, leaves [5, 7, 9] already inserted):
/// the path at index `3` must reconstruct `old_root` from an empty leaf.
///
/// * old_root  = 37680033528425405122238527642057696124242481062160987741795235162748292285817
/// * siblings  = [9, 20574097667437885391794119372359881141343659054235081333021421500136328328511]
/// * dirs      = [1, 1]  (index 3 is a right child at both levels)
test t_golden_reconstruct_old_root_index3() {
  let old_root =
    37680033528425405122238527642057696124242481062160987741795235162748292285817
  let sib_leaf = 9
  let sib_parent =
    20574097667437885391794119372359881141343659054235081333021421500136328328511
  valid_placement(old_root, 3, 2, empty_leaf, [sib_leaf, sib_parent])
}

/// After the path-verified transition the root must equal the Python tree root
/// for [5, 7, 9, 11].
test t_golden_insert_11_at_index3() {
  let old_root =
    37680033528425405122238527642057696124242481062160987741795235162748292285817
  let sib_leaf = 9
  let sib_parent =
    20574097667437885391794119372359881141343659054235081333021421500136328328511
  let new_root = 29950268572146257633010354406369443794802245030580194546219687757088559247940

  insert(old_root, 3, 2, 11, [sib_leaf, sib_parent]) == Some(new_root)
}

/// A tampered path must be rejected.
test t_insert_rejects_tampered_path() {
  let old_root =
    37680033528425405122238527642057696124242481062160987741795235162748292285817
  // Wrong sibling at the parent level.
  let sib_leaf = 9
  insert(old_root, 3, 2, 11, [sib_leaf, 12345]) == None
}

/// A path at the wrong index is rejected (dirs mismatch).
test t_insert_rejects_wrong_index() {
  let root =
    37680033528425405122238527642057696124242481062160987741795235162748292285817
  // Siblings valid for index 3, but requested for index 2.
  let sib_parent =
    20574097667437885391794119372359881141343659054235081333021421500136328328511
  insert(root, 2, 2, 11, [9, sib_parent]) == None
}

/// depth-3 example: after leaves [5, 7, 9, 11], inserting `13` at index `4`.
/// dirs = [0, 0, 1]; siblings = [0, poseidon(0,0), root_after_11].
test t_golden_depth3_insert_13_at_index4() {
  let h1 = poseidon.hash(0, 0)
  let root_after_11 = 29950268572146257633010354406369443794802245030580194546219687757088559247940
  let old_root =
    17644724837366521114017574009648596889975296600548105773695318175905545171304
  let new_root =
    24144726542737011911250967520968997615221048854578090271155510898787114171206

  let siblings = [0, h1, root_after_11]

  valid_placement(old_root, 4, 3, empty_leaf, siblings)
    && insert(old_root, 4, 3, 13, siblings) == Some(new_root)
}