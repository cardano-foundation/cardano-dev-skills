/// Note algebra over PoseidonBLS12_381, mirroring `aiken/f5/pool/pool.py`.
///
/// * `note_commitment = Poseidon(Poseidon(nullifier, amount), blinding)`
///   — the Merkle leaf deposited into the pool tree.
/// * `nullifier_hash = Poseidon(0, nullifier)`
///   — the public value that marks a note spent; the pool contract rejects
///   any nullifier hash already present in the spent set.

use f5/poseidon

/// The confidential Merkle leaf for a note.
pub fn note_commitment(nullifier: Int, amount: Int, blinding: Int) -> Int {
  poseidon.hash(poseidon.hash(nullifier, amount), blinding)
}

/// The public marker that spends a note.
pub fn nullifier_hash(nullifier: Int) -> Int {
  poseidon.hash(0, nullifier)
}

// ---------------------------------------------------------------------------
// Tests — goldens generated by the Python simulator
// ---------------------------------------------------------------------------

test t_golden_nullifier_hash_42() {
  nullifier_hash(42) == 15307798964445672632655570292288743182675488751143933031938310355569302673439
}

test t_golden_nullifier_hash_7() {
  nullifier_hash(7) == 12842762997125867576017080780783085433642794919276562515497304283823130423723
}

test t_golden_note_commitment_42_100_7() {
  note_commitment(42, 100, 7) ==
    35405951143278916932610262320666242042513375940489281528411596321729382302224
}

test t_golden_note_commitment_7_200_8() {
  note_commitment(7, 200, 8) ==
    26396643970472421475579137418228996597444372702255356750118640805847911459536
}

/// Different blinding must produce a different commitment for the same value.
test t_note_commitment_distinguishes_blinding() {
  note_commitment(42, 100, 7) != note_commitment(42, 100, 8)
}

/// A note commitment must depend on its nullifier.
test t_note_commitment_distinguishes_nullifier() {
  note_commitment(42, 100, 7) != note_commitment(43, 100, 7)
}