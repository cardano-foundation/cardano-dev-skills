/// The F5 privacy-pool contract state machine.
///
/// A single pool UTxO owns one Merkle root over deposited note commitments.
/// A *batch* spend consumes `N` escape proofs, all against the *same* current
/// root.  The contract:
///
/// 1. verifies all `N` Groth16 proofs in one batched pairing check
///    ([`groth16_batch.verify_batch`]),
/// 2. rejects any escape whose nullifier hash is already spent,
/// 3. recomputes the new root by path-verified insertion of each escape's two
///    output commitments (two fresh leaves per escape, in batch order),
/// 4. accumulates each escape's fee into `datum.fees`,
/// 5. seals the new root / next index / spent set / fees into the pool's
///    continuation output (the validator enforces the value rule and that the
///    continuation carries exactly this datum).
///
/// The pool logic is split into the *crypto-free* transition
/// ([`state_transition`], unit-testable without real proofs) and the full
/// [`check_batch`] wrapper that gates it behind proof verification.

use aiken/collection/list
use f5/groth16_batch
use f5/groth16_batch.{Proof, VerificationKey, verify_batch}
use f5/merkle

/// Public-variable layout of `privacy_pool.circom`:
/// `[constant_wire, merkle_root, nullifier_hash, out1, out2, fee]`.
pub const constant_wire = 1
pub const n_public = 6

/// The pool's on-chain state (carried as the datum of the pool UTxO).
pub type PoolDatum {
  root: Int,
  next_index: Int,
  spent: List<Int>,
  fees: Int,
}

/// One escape in a batch spend.
///
/// `path_out1` / `path_out2` are the leaf-up Merkle siblings for inserting
/// `out_commitment_1` at `next_index` and `out_commitment_2` at
/// `next_index + 1` — each path valid in the tree at the moment of its own
/// insertion (i.e. `path_out2` is valid *after* `out_commitment_1` is in).
pub type Escapo {
  proof: Proof,
  nullifier_hash: Int,
  out_commitment_1: Int,
  out_commitment_2: Int,
  fee: Int,
  path_out1: List<Int>,
  path_out2: List<Int>,
}

/// Full batch spend check: verify every proof, then apply the state
/// transition.  Returns the new datum, or `None` on any failure.
pub fn check_batch(
  vk: VerificationKey,
  depth: Int,
  datum: PoolDatum,
  escapes: List<Escapo>,
) -> Option<PoolDatum> {
  if list.is_empty(escapes) {
    None
  } else {
    let proofs = list.map(escapes, fn(e) { e.proof })
    let publics = list.map(escapes, fn(e) {
      [constant_wire, datum.root, e.nullifier_hash, e.out_commitment_1, e.out_commitment_2, e.fee]
    })
    if verify_batch(proofs, publics, vk) {
      state_transition(datum, depth, escapes)
    } else {
      None
    }
  }
}

/// Crypto-free state transition: freshness of the nullifier hashes, the two
/// path-verified insertions per escape, and fee accumulation.  Exposed as
/// `pub` so it can be tested without real proof objects; the validator only
/// ever calls it through [`check_batch`].
pub fn state_transition(
  datum: PoolDatum,
  depth: Int,
  escapes: List<Escapo>,
) -> Option<PoolDatum> {
  do_transition(datum, depth, escapes, datum)
}

fn do_transition(
  datum: PoolDatum,
  depth: Int,
  escapes: List<Escapo>,
  acc: PoolDatum,
) -> Option<PoolDatum> {
  when escapes is {
    [] -> Some(acc)
    [e, ..rest] -> {
      // The nullifier hash must not have been spent, nor announced by an
      // earlier escape in the same batch.
      if list.has(acc.spent, e.nullifier_hash) {
        None
      } else {
        // Insert out_commitment_1 at `next_index`, then out_commitment_2 at
        // `next_index + 1` (its path is valid only after the first insert).
        when merkle.insert(acc.root, acc.next_index, depth, e.out_commitment_1, e.path_out1) is {
          None -> None
          Some(root1) -> {
            when merkle.insert(root1, acc.next_index + 1, depth, e.out_commitment_2, e.path_out2) is {
              None -> None
              Some(root2) -> {
                let next = PoolDatum {
                  root: root2,
                  next_index: acc.next_index + 2,
                  spent: [e.nullifier_hash, ..acc.spent],
                  fees: acc.fees + e.fee,
                }
                do_transition(datum, depth, rest, next)
              }
            }
          }
        }
      }
    }
  }
}

/// The pool preserves its principal: the continuation output must carry the
/// same lovelace as the pool input.  Fees accrue in `datum.fees` for a later
/// operator withdrawal (outside this validator's scope).
pub fn value_rule(pool_in_lovelace: Int, pool_out_lovelace: Int) -> Bool {
  pool_in_lovelace == pool_out_lovelace
}

// ---------------------------------------------------------------------------
// Tests — goldens generated by the Python simulator (depth 3)
// ---------------------------------------------------------------------------

/// A depth-3 batch of two escapes against the tree seeded with [5, 7, 9, 11].
///
/// * initial root = 17644724837366521114017574009648596889975296600548105773695318175905545171304 (idx 4)
/// * escape 1: nh(21), out = 101 @ idx 4, 202 @ idx 5, fee 5
/// * escape 2: nh(22), out = 303 @ idx 6, 404 @ idx 7, fee 7
/// * final      root = 17609010552588860221271192423808822806990405673238281309580470059016819760888 (idx 8)
test t_state_transition_two_escapes_depth3() {
  let h1 = 39704413365395714732902920194612999065094381874203236779011164022408220537174
  let root_after_11 = 29950268572146257633010354406369443794802245030580194546219687757088559247940
  let sibling_esc2 = 13034944854718335066623558153882162496268204878265402242746678764635773885516

  let datum = PoolDatum {
    root: 17644724837366521114017574009648596889975296600548105773695318175905545171304,
    next_index: 4,
    spent: [],
    fees: 0,
  }

  let e1 = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 24096055781742484025791279838042575332684781461208896194036274310124051958202,
    out_commitment_1: 101,
    out_commitment_2: 202,
    fee: 5,
    path_out1: [0, h1, root_after_11],
    path_out2: [101, h1, root_after_11],
  }
  let e2 = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 41239237981501373437197934352812641336383385549336005572060409082839687982414,
    out_commitment_1: 303,
    out_commitment_2: 404,
    fee: 7,
    path_out1: [0, sibling_esc2, root_after_11],
    path_out2: [303, sibling_esc2, root_after_11],
  }

  when state_transition(datum, 3, [e1, e2]) is {
    Some(new_datum) ->
      new_datum.root == 17609010552588860221271192423808822806990405673238281309580470059016819760888
        && new_datum.next_index == 8
        && new_datum.fees == 12
        && list.has(new_datum.spent, 24096055781742484025791279838042575332684781461208896194036274310124051958202)
        && list.has(new_datum.spent, 41239237981501373437197934352812641336383385549336005572060409082839687982414)
    None -> False
  }
}

/// Re-spending an already spent nullifier must fail.
test t_transition_rejects_double_spend() {
  let h1 = 39704413365395714732902920194612999065094381874203236779011164022408220537174
  let root_after_11 = 29950268572146257633010354406369443794802245030580194546219687757088559247940

  let datum = PoolDatum {
    root: 17644724837366521114017574009648596889975296600548105773695318175905545171304,
    next_index: 4,
    spent: [24096055781742484025791279838042575332684781461208896194036274310124051958202],
    fees: 0,
  }

  let e1 = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 24096055781742484025791279838042575332684781461208896194036274310124051958202,
    out_commitment_1: 101,
    out_commitment_2: 202,
    fee: 5,
    path_out1: [0, h1, root_after_11],
    path_out2: [101, h1, root_after_11],
  }

  state_transition(datum, 3, [e1]) == None
}

/// A batch announcing the same nullifier hash twice is rejected.
test t_transition_rejects_duplicate_nullifier_in_batch() {
  let h1 = 39704413365395714732902920194612999065094381874203236779011164022408220537174
  let root_after_11 = 29950268572146257633010354406369443794802245030580194546219687757088559247940
  let sibling_esc2 = 13034944854718335066623558153882162496268204878265402242746678764635773885516

  let datum = PoolDatum {
    root: 17644724837366521114017574009648596889975296600548105773695318175905545171304,
    next_index: 4,
    spent: [],
    fees: 0,
  }

  let e1 = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 24096055781742484025791279838042575332684781461208896194036274310124051958202,
    out_commitment_1: 101,
    out_commitment_2: 202,
    fee: 5,
    path_out1: [0, h1, root_after_11],
    path_out2: [101, h1, root_after_11],
  }
  let dup = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 24096055781742484025791279838042575332684781461208896194036274310124051958202,
    out_commitment_1: 303,
    out_commitment_2: 404,
    fee: 7,
    path_out1: [0, sibling_esc2, root_after_11],
    path_out2: [303, sibling_esc2, root_after_11],
  }

  state_transition(datum, 3, [e1, dup]) == None
}

/// A bad second-output path (not valid after the first insert) is rejected.
test t_transition_rejects_tampered_second_path() {
  let h1 = 39704413365395714732902920194612999065094381874203236779011164022408220537174
  let root_after_11 = 29950268572146257633010354406369443794802245030580194546219687757088559247940

  let datum = PoolDatum {
    root: 17644724837366521114017574009648596889975296600548105773695318175905545171304,
    next_index: 4,
    spent: [],
    fees: 0,
  }

  let e1 = Escapo {
    proof: groth16_batch.hardcoded_proof(),
    nullifier_hash: 24096055781742484025791279838042575332684781461208896194036274310124051958202,
    out_commitment_1: 101,
    out_commitment_2: 202,
    fee: 5,
    path_out1: [0, h1, root_after_11],
    // Wrong sibling where the freshly inserted 101 should anchor the path.
    path_out2: [0, h1, root_after_11],
  }

  state_transition(datum, 3, [e1]) == None
}

test t_value_rule_preserves_principal() {
  value_rule(5_000_000, 5_000_000) && !value_rule(5_000_000, 5_000_001)
}

test t_check_batch_rejects_empty() {
  let vk = groth16_batch.hardcoded_verification_key()
  let datum = PoolDatum { root: 0, next_index: 0, spent: [], fees: 0 }
  check_batch(vk, 3, datum, []) == None
}